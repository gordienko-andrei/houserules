{
  "name": "@andrewgordienko/houserules",
  "version": "0.2.1",
  "description": "Turns an Angular design system into context and checks for AI agents",
  "keywords": [
    "angular",
    "design-system",
    "ai-agents",
    "agents-md",
    "eslint",
    "lint",
    "cli"
  ],
  "homepage": "https://github.com/gordienko-andrei/houserules/blob/main/docs/guide.md",
  "bugs": "https://github.com/gordienko-andrei/houserules/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gordienko-andrei/houserules.git",
    "directory": "packages/cli"
  },
  "license": "MIT",
  "author": "Andrei Gordienko",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "houserules": "./dist/cli.mjs"
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./stylelint": "./dist/stylelint.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "pnpm run build",
    "build": "tsdown src/index.ts src/cli.ts src/stylelint.ts --dts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "citty": "^0.2.2",
    "jiti": "^2.7.0",
    "minimatch": "^10.2.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@angular-eslint/template-parser": "^22.6.0",
    "tsdown": "^0.23.5",
    "typescript": "~6.0.3"
  },
  "peerDependencies": {
    "@angular-eslint/template-parser": ">=18.0.0",
    "typescript": ">=5.0.0"
  }
}
