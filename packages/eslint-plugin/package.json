{
  "name": "eslint-plugin-houserules",
  "version": "0.1.0",
  "description": "ESLint rules for Angular templates that keep AI agents inside your design system",
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "angular",
    "angular-templates",
    "design-system",
    "ai-agents"
  ],
  "homepage": "https://github.com/gordienko-andrei/houserules/tree/main/packages/eslint-plugin#readme",
  "bugs": "https://github.com/gordienko-andrei/houserules/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gordienko-andrei/houserules.git",
    "directory": "packages/eslint-plugin"
  },
  "license": "MIT",
  "author": "Andrei Gordienko",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "pnpm run build",
    "build": "tsdown src/index.ts --dts --exports",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "eslint": "^9.0.0 || ^10.0.0",
    "@angular-eslint/template-parser": ">=18.0.0",
    "@andrewgordienko/houserules": "workspace:^"
  },
  "dependencies": {
    "@typescript-eslint/utils": "^8.72.1"
  },
  "devDependencies": {
    "@angular-eslint/template-parser": "^22.6.0",
    "@typescript-eslint/rule-tester": "^8.72.1",
    "eslint": "^10.13.0",
    "@andrewgordienko/houserules": "workspace:*",
    "tsdown": "^0.23.5"
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  }
}
